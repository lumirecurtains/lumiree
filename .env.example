# Firebase configuration for local development and build-time environment variables.
# Copy this file to .env and populate values with your Firebase project settings.
# Do not commit real secrets to source control.
# For Vercel deployment, set the same values in the Vercel Environment Variables panel.

VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# ---------------------------------------------------------------------------
# Server-side variables for the /api/admin-users Vercel serverless function.
# These are SECRET. Never prefix them with VITE_ (that would expose them to
# the browser bundle). Set them in Vercel > Project > Settings > Environment
# Variables for Production (and Preview if needed).
#
# Get the service account JSON from:
# Firebase Console > Project Settings > Service Accounts > Generate new private key
#
# Option A: paste the whole JSON on one line
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-...@your_project.iam.gserviceaccount.com",...}

# Option B: split values (use instead of FIREBASE_SERVICE_ACCOUNT)
# FIREBASE_PROJECT_ID=your_project_id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-...@your_project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional override of the permanent Super Admin email (defaults to the value in src/lib/constants.ts)
# SUPER_ADMIN_EMAIL=lexcorp0777@gmail.com

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function normalizedEmail(email) {
      return email != null ? email.lower() : '';
    }

    function isSuperAdmin() {
      return isAuthenticated() &&
        normalizedEmail(request.auth.token.email) == 'lexcorp0777@gmail.com';
    }

    function hasAdminClaim() {
      return isAuthenticated() && request.auth.token.get('role', '') == 'admin';
    }

    function isActiveAdmin(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.role == 'admin' &&
        get(/databases/$(database)/documents/users/$(userId)).data.status == 'active';
    }

    function isAdmin() {
      return isSuperAdmin() || hasAdminClaim() || (
        isAuthenticated() && isActiveAdmin(request.auth.uid)
      );
    }

    match /emailIndex/{emailId} {
      allow read: if isAdmin();
      allow create, update, delete: if isSuperAdmin();
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow read: if isAdmin();

      allow create: if isAuthenticated() && (
        (
          request.auth.uid == userId
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.email == normalizedEmail(request.auth.token.email)
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() > 0
          && request.resource.data.role in ['customer', 'admin', 'super_admin']
          && (request.resource.data.role != 'super_admin' || isSuperAdmin())
          && (request.resource.data.role != 'admin' || hasAdminClaim())
          && request.resource.data.status == 'active'
          && request.resource.data.wishlist is list
          && request.resource.data.recentlyViewed is list
          && request.resource.data.createdAt is timestamp
        )
        ||
        (
          isSuperAdmin()
          && request.resource.data.uid == userId
          && request.resource.data.email is string
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() > 0
          && request.resource.data.role in ['admin', 'super_admin']
          && request.resource.data.status in ['active', 'inactive']
          && request.resource.data.wishlist is list
          && request.resource.data.recentlyViewed is list
          && request.resource.data.createdAt is timestamp
        )
      );

      allow update: if isAuthenticated() && request.auth.uid == userId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'uid', 'email', 'createdAt']);

      allow update: if isSuperAdmin();

      allow delete: if isSuperAdmin() && normalizedEmail(resource.data.email) != 'lexcorp0777@gmail.com';
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /testimonials/{testimonialId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /faqs/{faqId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /inquiries/{inquiryId} {
      // Public contact/quote/installation forms — validated to prevent abuse.
      allow create: if request.resource.data.keys().hasOnly(['type', 'name', 'email', 'phone', 'message', 'productId', 'status', 'createdAt'])
        && request.resource.data.type in ['product', 'quote', 'installation', 'bulk', 'general']
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 32
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 5000
        && request.resource.data.status == 'new';
      allow read, update, delete: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      // Business contact info is managed by any active admin;
      // all other settings remain Super Admin only.
      allow create, update: if settingId == 'contactInfo' ? isAdmin() : isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    match /gallery/{imageId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['userName', 'userEmail', 'rating', 'title', 'text', 'productId', 'productName', 'status', 'createdAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.userName is string
        && request.resource.data.userName.size() > 0
        && request.resource.data.userName.size() <= 120
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 5000;
      allow update, delete: if isAdmin();
    }
  }
}
